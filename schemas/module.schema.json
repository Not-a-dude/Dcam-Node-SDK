{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcam.org/schemas/node-module-v1.json",
  "title": "Dcam node module",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "nodeAbi", "library", "nodeTypes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$" },
    "version": { "type": "string" },
    "nodeAbi": {
      "type": "object",
      "description": "ABI version used to build the node. Loaders accept the same major and a node minor not newer than their own.",
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "library": { "type": "string", "pattern": "^lib.+\\.so$" },
    "nodeTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "parameters", "inputs", "outputs"],
        "properties": {
          "id": { "type": "string" },
          "parameters": { "type": "object" },
          "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
          "outputs": { "type": "array", "items": { "$ref": "#/$defs/port" } }
        }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["frame", "metadata", "audio", "encodedPacket", "surface", "requestState", "outputFd"] },
        "formats": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
