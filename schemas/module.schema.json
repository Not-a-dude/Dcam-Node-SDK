{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcam.org/schemas/node-module-v1.json",
  "title": "Dcam node module package manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "publisherKey",
    "nodeAbi",
    "library",
    "nodeFiles"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "publisherKey": {
      "type": "string",
      "minLength": 32,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "description": "Base64-encoded X.509 Ed25519 public key used to verify signature.ed25519."
    },
    "nodeAbi": {
      "type": "object",
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "const": 0 }
      },
      "additionalProperties": false
    },
    "library": { "$ref": "#/$defs/library" },
    "dependencies": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+(\\.[a-z0-9_-]+)+$": { "$ref": "#/$defs/versionRange" }
      },
      "additionalProperties": false
    },
    "nodeFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nodeFile" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "versionRange": {
      "type": "string",
      "pattern": "^(?:\\^)?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "library": {
      "type": "object",
      "required": ["abi", "path", "soname", "sha256", "needed"],
      "properties": {
        "abi": { "const": "arm64-v8a" },
        "path": {
          "allOf": [
            { "$ref": "#/$defs/path" },
            { "pattern": "^lib/arm64-v8a/lib[A-Za-z0-9_.+-]+\\.so$" }
          ]
        },
        "soname": { "type": "string", "pattern": "^lib[A-Za-z0-9_.+-]+\\.so$" },
        "sha256": { "$ref": "#/$defs/hash" },
        "needed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^lib[A-Za-z0-9_.+-]+\\.so$" }
        }
      },
      "additionalProperties": false
    },
    "nodeFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/path" },
            { "pattern": "^nodes/.+\\.node\\.json$" }
          ]
        },
        "sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
