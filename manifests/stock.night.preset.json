{
  "schemaVersion": 1,
  "id": "org.dcam.stock.night",
  "version": "1.0.0",
  "requirements": { "org.dcam.stock": "^1.0.0" },
  "parameters": [],
  "nodes": [
    { "id": "input", "type": "org.dcam.stock.photo", "parameters": {} },
    { "id": "shading", "type": "org.dcam.stock.lens_shading", "parameters": {} },
    { "id": "demosaic", "type": "org.dcam.stock.demosaic", "parameters": {} },
    { "id": "crop_zoom", "type": "org.dcam.stock.crop_zoom", "parameters": {} },
    { "id": "linearize", "type": "org.dcam.stock.linearize", "parameters": {} },
    { "id": "wb", "type": "org.dcam.stock.white_balance", "parameters": {} },
    { "id": "ccm", "type": "org.dcam.stock.color_matrix", "parameters": {} },
    { "id": "tonemap", "type": "org.dcam.stock.tonemap", "parameters": {} },
    { "id": "rotate", "type": "org.dcam.stock.rotate", "parameters": {} },
    { "id": "preview", "type": "org.dcam.stock.preview", "parameters": {} },
    { "id": "jpeg", "type": "org.dcam.stock.jpeg", "parameters": {} },
    { "id": "heic", "type": "org.dcam.stock.heic", "parameters": {} },
    { "id": "dng", "type": "org.dcam.stock.dng", "parameters": {} }
  ],
  "edges": [
    { "from": "input.out", "to": "shading.in" },
    { "from": "shading.out", "to": "demosaic.in" },
    { "from": "demosaic.out", "to": "crop_zoom.in" },
    { "from": "crop_zoom.out", "to": "linearize.in" },
    { "from": "linearize.out", "to": "wb.in" },
    { "from": "wb.out", "to": "ccm.in" },
    { "from": "ccm.out", "to": "tonemap.in" },
    { "from": "tonemap.out", "to": "rotate.in" },
    { "from": "rotate.out", "to": "preview.in" },
    { "from": "rotate.out", "to": "jpeg.in" },
    { "from": "rotate.out", "to": "heic.in" },
    { "from": "input.raw", "to": "dng.raw" }
  ],
  "zsl": { "depth": 3 }
}
